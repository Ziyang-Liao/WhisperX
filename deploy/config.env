# Deployment configuration for the WhisperX subtitle platform.
# Sourced by deploy.sh / teardown.sh. Edit values here, not in the scripts.
#
# HARD RULE: this stack deploys ONLY to the temp-account profile. Never default.

export AWS_PROFILE="temp-account"
export AWS_REGION="us-east-1"

# Unique suffix so resource names don't collide. Set once; keep stable for teardown.
export STACK="whisperx-subs"

# Bedrock model (cross-region inference profile; bare IDs are rejected on this account).
export BEDROCK_MODEL_ID="us.anthropic.claude-haiku-4-5-20251001-v1:0"

# CPU instance for WhisperX (GPU quota is 0 on this account).
export INSTANCE_TYPE="c7i.2xlarge"

# Resource names (derived).
export BUCKET="${STACK}-ACCOUNT_ID_REDACTED-${AWS_REGION}"
export ROLE_NAME="${STACK}-ec2-role"
export INSTANCE_PROFILE="${STACK}-ec2-profile"
export SG_NAME="${STACK}-sg"
export INSTANCE_NAME="${STACK}-app"
export TAG_KEY="project"
export TAG_VAL="${STACK}"

# Port the FastAPI app listens on / is exposed on.
export APP_PORT="8000"
